function area = circle_square_intersection_area(xc, yc, r, xs, ys, w, h)
    % Calculate the area of intersection between a circle and a square.
    % Inputs:
    %   xc, yc: Circle center coordinates.
    %   r: Circle radius.
    %   xs, ys: Square center coordinates.
    %   w, h: Square width and height.
    % Output:
    %   area: Area of intersection.

    % Define the square boundaries
    x_min_square = xs - w/2;
    x_max_square = xs + w/2;
    y_min_square = ys - h/2;
    y_max_square = ys + h/2;

    % Define the circle boundaries
    x_min_circle = xc - r;
    x_max_circle = xc + r;

    % Determine the x-bounds for integration
    x_min = max(x_min_square, x_min_circle);
    x_max = min(x_max_square, x_max_circle);

    % Check if there is no intersection
    if x_min >= x_max
        area = 0;
        return;
    end

    % Define the integrand for the area calculation
    area = integral(@(x) yIntegral(x, xc, yc, r, y_min_square, y_max_square), x_min, x_max);
    % Make sure the smaller area of intersection if returned
    if area > w * h / 2
        area = w * h - area;
    end

    % Nested function to compute the y-integral for a given x
    function y_int = yIntegral(x, xc, yc, r, y_min_square, y_max_square)
        % Calculate the y-bounds for a given x
        y_min_circle = yc - sqrt(r^2 - (x - xc).^2);
        y_max_circle = yc + sqrt(r^2 - (x - xc).^2);

        % Determine the y-bounds for integration
        y_min = max(y_min_square, y_min_circle);
        y_max = min(y_max_square, y_max_circle);

        % Check if there is no intersection in y for this x
        if y_min >= y_max
            y_int = 0;
        else
            y_int = y_max - y_min;
        end
    end
end